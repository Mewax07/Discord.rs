DISCORD_TOKEN=your-bot-token
GUILD_ID=your-guild-id
OWNER_ID=your-discord-user-id
LOGS_CHANNEL_ID=

PRODUCT_NAME=BadOmen Visuals
LICENSE_API_TOKEN=generate-a-random-48-hex-characters-token
LICENSE_OFFLINE_DAYS=14

LICENSE_API_ADDR=127.0.0.1:8080
WEB_ADDR=127.0.0.1:8080
WEB_ENABLED=true
WEB_PUBLIC_DIR=public
WEB_FILES_DIR=files
SITE_NAME=BadOmen
DISCORD_INVITE_URL=

# Admin panel (/admin) — recap of visits and licences.
# Reachable from loopback plus the IPs listed here, and gated by a password.
ADMIN_PANEL_ENABLED=true
ADMIN_PASSWORD=choose-a-strong-password
# Comma-separated external IPs allowed to open the panel (empty = loopback only).
ADMIN_ALLOWED_IPS=
# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For.
ADMIN_TRUST_FORWARDED_FOR=false
# Optional: stable secret (16+ chars) so admin/user sessions survive a restart.
# Leave empty to generate a fresh random secret on every run.
ADMIN_SESSION_SECRET=

# User space (/account) — Discord login so users see the machines bound to
# their licences. Create an application at https://discord.com/developers and
# add the redirect URL below to OAuth2 > Redirects.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT=http://127.0.0.1:8080/account/callback
